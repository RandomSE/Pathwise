# Pathwise recruiter sidecar secrets.
# Recruiter Windows zip: save this file as pathwise.env in the SAME FOLDER as
# Pathwise.exe (the folder that contains the exe, not the _internal folder).
# Candidates: leave this file out. Play does not need Turso or SMTP.
#
# Never commit this file with real values. Never email TURSO_AUTH_TOKEN.
# That token is full database access on the current SQL-over-HTTP client.

# Required for recruiter login, register, and Generate seed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. If unset, Pathwise skips email notify and warns that email is off.
PATHWISE_SMTP_HOST=
PATHWISE_SMTP_PORT=587
PATHWISE_SMTP_USER=
PATHWISE_SMTP_PASSWORD=
PATHWISE_SMTP_FROM=

# Optional. Default off. Set to 1 to require billing flags on generate.
PATHWISE_REQUIRE_BILLING=

# Optional fairness pin for scripted runs. Not a recruiter secret.
# Candidate quick play with an empty seed does not use this.
PATHWISE_SEED=
