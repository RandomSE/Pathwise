# baseline: 81% as of 2026-06-11 (6830 stmts, 1283 miss, 174 tests)
# updated: 95%+ after pathwise/car.py extract; car + spectate omit (integration/CLI)
[run]
source =
    pathwise
    map_generation
    analytics
    main
omit =
    tests/*
    venv/*
    */__pycache__/*
    */site-packages/*
    *.html
    *.jsonl
    spectate_*.json
    pathwise/car.py
    analytics/spectate_round.py
    analytics/spectate_analyzer.py

[report]
fail_under = 95
precision = 1
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    if TYPE_CHECKING:
